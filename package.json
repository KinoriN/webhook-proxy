{
  "name": "@kinori/webhook-proxy",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "webhook-proxy": "./bin/webhook-proxy.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite",
    "dev:full": "concurrently \"pnpm dev:client\" \"pnpm dev\"",
    "build": "vite build && wrangler deploy",
    "build:client": "vite build",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "type-check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "hono": "^4.12.15",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4",
    "concurrently": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "wrangler": "^4"
  }
}
